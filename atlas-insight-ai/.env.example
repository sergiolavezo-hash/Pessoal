# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credential encryption at rest (generate: openssl rand -base64 32)
ENCRYPTION_KEY=

# AI provider — anthropic (default) | openai | google
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
OPENAI_API_KEY=
# OPENAI_MODEL=
GOOGLE_AI_API_KEY=
# GOOGLE_AI_MODEL=

# Query engine guardrails
QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=10000

# Transactional email (signup effectivation). Optional — skipped gracefully.
# RESEND_API_KEY=            # resend.com — welcome email to the new user
# EMAIL_FROM=Atlas Insight AI <no-reply@atlas-partner.com>
# SIGNUP_NOTIFY_ENDPOINT=    # e.g. FormSubmit AJAX endpoint for new-signup alerts to the Atlas inbox

# Stripe — required only when billing checkout goes live
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
