{
  "name": "Atlas WHITE",
  "dataColors": [
    "#2563EB",
    "#2563EB",
    "#16A34A",
    "#CA8A04",
    "#DC2626",
    "#94A3B8",
    "#15803D",
    "#B91C1C"
  ],
  "background": "#FFFFFF",
  "foreground": "#1E293B",
  "tableAccent": "#2563EB",
  "good": "#16A34A",
  "neutral": "#CA8A04",
  "bad": "#DC2626",
  "maximum": "#1E40AF",
  "minimum": "#F1F5F9",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#1E293B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1E293B"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#788599"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 34,
      "color": "#1E293B"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#1E293B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8,
            "show": true
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "grid": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#788599"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
